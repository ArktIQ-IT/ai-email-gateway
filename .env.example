DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO
REQUEST_MAX_BYTES=1048576
IMAP_TIMEOUT_SECONDS=30
MAX_LOOKBACK_DAYS=365
DEFAULT_RANGE_HOURS=24
MAX_LIMIT=200
ALLOW_RAW=false
CACHE_BODY=false
JOB_TTL_MINUTES=60
LOCK_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_JOBS_PER_MINUTE=30
GLOBAL_IMAP_SESSIONS=10
ACCOUNT_IMAP_SESSIONS=1
# Example secret env vars referenced from config/accounts.yaml
# ACME_IMAP_PASSWORD=super-secret
